# Copy to android/keystore.properties (never commit the real file).
# Generate a release keystore:
#   keytool -genkey -v -keystore uaetrail-release.keystore -alias uaetrail -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../uaetrail-release.keystore
storePassword=your-store-password
keyAlias=uaetrail
keyPassword=your-key-password
