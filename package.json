{
  "name": "uaetrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "uuid": "^14.0.3",
    "lodash.get": "npm:lodash@^4.17.21",
    "lodash.isequal": "npm:lodash@^4.17.21",
    "exceljs": {
      "unzipper": "^0.12.5"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:fresh": "node scripts/clear-vite-cache.mjs && vite --force",
    "dev:api": "npm --workspace @uaetrail/api run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "dev:all:fresh": "concurrently \"npm run dev:fresh\" \"npm run dev:api\"",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:fast": "node scripts/run-project.mjs --fast",
    "deploy:stack": "node scripts/run-project.mjs --docker",
    "build": "vite build",
    "build:api": "npm --workspace @uaetrail/api run build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:api": "npm --workspace @uaetrail/api run typecheck",
    "seed": "npm --workspace @uaetrail/api run seed",
    "seeking:storage-status": "npm --workspace @uaetrail/api run seeking-storage-status --",
    "seeking:deploy-gate": "npm run seeking:storage-status -- --strict",
    "test:seeking-local": "npm --workspace @uaetrail/api run test -- --run tests/participant-intent-stub-write-default.test.ts tests/participant-intent-seeking-activity-primary.test.ts tests/participant-intent-seeking-route-primary.test.ts tests/explore-map-seeking-projection.test.ts",
    "verify:host-member": "node scripts/verify-host-member.mjs",
    "verify:docs": "node scripts/verify-docs-tier1.mjs",
    "consumer-detail:qa-routes": "node scripts/consumer-detail-manual-qa-routes.mjs",
    "verify:domain": "node scripts/verify-domain-canonicals.mjs",
    "verify:system": "node scripts/verify-system-coherence.mjs",
    "verify:system:quick": "node scripts/verify-system-coherence.mjs --quick",
    "test:api": "npm --workspace @uaetrail/api run test",
    "test:frontend": "vitest run",
    "test:explore-alignment": "vitest run src/config/discoveryCardBuilderGuard.test.ts src/discovery/discoveryCardViewModel.test.ts src/explore/exploreCopy.test.ts src/explore/exploreFixtureResidueGuard.test.ts src/explore/exploreModuleBoundary.test.ts src/explore/exploreMapItemWireGuard.test.ts src/explore/exploreActivityMode.test.ts src/content/copyGuard.test.ts src/explore/composeFlowCatalog.test.ts src/explore/exploreBuddySubtype.test.ts src/explore/exploreOutingTopic.test.ts src/explore/exploreRouting.test.ts src/explore/explorePinTypes.test.ts src/explore/ui/organizeFlow.test.ts src/explore/ui/organizeFlows/organizeFlows.registry.test.ts src/explore/ui/organizeFromActivity.test.ts src/explore/ui/createDraftFromSeekingMapItem.test.ts src/explore/ui/demandFlow.test.ts src/explore/ui/contributeFlow.test.ts && npm --workspace @uaetrail/api run test -- --run tests/explore-map-layers.test.ts tests/explore-map-publish.test.ts tests/explore-map-seeking-projection.test.ts tests/explore-plan-projection.test.ts tests/wishlist-match.test.ts",
    "knip": "knip",
    "ci": "npm run typecheck && npm run typecheck:api && npm run verify:system:quick && npm run lint && npm run build && npm run build:api && npm run test:frontend && npm run test:api",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "icons:generate": "node scripts/generate-icons.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:env:prod": "node scripts/validate-env.mjs --production --file .env"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.104.2",
    "@types/leaflet.markercluster": "^1.5.6",
    "@uaetrail/shared-types": "*",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
