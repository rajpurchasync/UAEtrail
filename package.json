{
  "name": "uaetrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --workspace @uaetrail/api run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:fast": "node scripts/run-project.mjs --fast",
    "deploy:stack": "node scripts/run-project.mjs --docker",
    "build": "vite build",
    "build:api": "npm --workspace @uaetrail/api run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:api": "npm --workspace @uaetrail/api run typecheck",
    "seed": "npm --workspace @uaetrail/api run seed",
    "seeking:storage-status": "npm --workspace @uaetrail/api run seeking-storage-status --",
    "seeking:deploy-gate": "npm run seeking:storage-status -- --strict",
    "test:seeking-local": "npm --workspace @uaetrail/api run test -- --run tests/participant-intent-stub-write-default.test.ts tests/participant-intent-seeking-activity-primary.test.ts tests/participant-intent-seeking-route-primary.test.ts tests/explore-map-seeking-projection.test.ts",
    "verify:host-member": "node scripts/verify-host-member.mjs",
    "verify:docs": "node scripts/verify-docs-tier1.mjs",
    "consumer-detail:qa-routes": "node scripts/consumer-detail-manual-qa-routes.mjs",
    "s10f:qa-checklist": "npm run consumer-detail:qa-routes",
    "verify:domain": "node scripts/verify-domain-canonicals.mjs",
    "verify:system": "node scripts/verify-system-coherence.mjs",
    "verify:system:quick": "node scripts/verify-system-coherence.mjs --quick",
    "test:api": "npm --workspace @uaetrail/api run test",
    "test:frontend": "vitest run",
    "test:explore-alignment": "vitest run src/config/discoveryCardBuilderGuard.test.ts src/discovery/discoveryCardViewModel.test.ts src/explore/exploreCopy.test.ts src/explore/exploreFixtureResidueGuard.test.ts src/explore/exploreModuleBoundary.test.ts src/explore/exploreMapItemWireGuard.test.ts src/explore/exploreActivityMode.test.ts src/content/copyGuard.test.ts src/explore/composeFlowCatalog.test.ts src/explore/exploreBuddySubtype.test.ts src/explore/exploreOutingTopic.test.ts src/explore/exploreRouting.test.ts src/explore/exploreBrowseUrlHydrate.test.ts src/explore/explorePinTypes.test.ts src/explore/ui/organizeFlow.test.ts src/explore/ui/organizeFlows/organizeFlows.registry.test.ts src/explore/ui/organizeFromActivity.test.ts src/explore/ui/createDraftFromSeekingMapItem.test.ts src/explore/ui/demandFlow.test.ts src/explore/ui/contributeFlow.test.ts && npm --workspace @uaetrail/api run test -- --run tests/explore-map-layers.test.ts tests/explore-map-publish.test.ts tests/explore-map-seeking-projection.test.ts tests/explore-plan-projection.test.ts tests/wishlist-match.test.ts",
    "knip": "knip",
    "ci": "npm run typecheck && npm run typecheck:api && npm run verify:system:quick && npm run lint && npm run build && npm run build:api && npm run test:frontend && npm run test:api",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "icons:generate": "node scripts/generate-icons.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:env:prod": "node scripts/validate-env.mjs --production --file .env"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.4.1",
    "@react-oauth/google": "^0.12.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@uaetrail/shared-types": "*",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "knip": "^5.63.0",
    "postcss": "^8.4.35",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
