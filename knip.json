{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "src/index.css",
        "src/styles/fonts.css",
        "src/**/*.{test,spec}.{ts,tsx}",
        "scripts/**/*.{mjs,js}"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,js}"]
    },
    "apps/api": {
      "entry": [
        "scripts/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@capacitor/android",
    "@capacitor/ios",
    "@lhci/cli",
    "@emnapi/core",
    "@emnapi/runtime",
    "playwright"
  ],
  "ignoreBinaries": ["adb"],
  "ignoreIssues": {
    "apps/api/src/app.ts": ["exports"],
    "src/config/platform.ts": ["exports"],
    "src/config/surfacePaths.ts": ["exports"],
    "src/utils/placePaths.ts": ["exports"],
    "src/utils/venueDetailDisplay.ts": ["exports"],
    "src/utils/eventVenue.ts": ["exports"],
    "src/components/ui/MapPlacePicker.tsx": ["exports"],
    "src/components/ui/ActivityPlacePinField.tsx": ["exports"],
    "src/components/ui/PlaceCatalogCardFrame.tsx": ["exports"],
    "src/components/ui/PlaceCardActions.tsx": ["exports"],
    "src/components/ui/PlaceCard.tsx": ["exports"],
    "src/components/ui/PlaceDetailTabs.tsx": ["exports"],
    "src/components/ui/SubmitPlaceForm.tsx": ["exports"],
    "src/components/ui/PlaceSelect.tsx": ["exports"],
    "src/components/ui/PlaceDirectionLinks.tsx": ["exports"],
    "src/components/ui/PlacesMap.tsx": ["exports"],
    "src/components/activities/ActivityActionsMenu.tsx": ["exports"],
    "src/components/activities/index.ts": ["exports"],
    "src/utils/activityPublishPayload.ts": ["exports"]
  }
}
