{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["index.html", "scripts/**/*.{mjs,js}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,js}"]
    },
    "apps/api": {
      "entry": ["src/index.ts", "scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@capacitor/android", "@capacitor/ios"],
  "ignoreIssues": {
    "apps/api/src/app.ts": ["exports"]
  }
}
