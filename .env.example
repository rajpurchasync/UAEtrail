# ─── UAE Trail — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────────────────

# ─── Runtime Environment ───────────────────────────────────────────────────
# Allowed values: test, staging, production
# local is accepted and mapped to test by the launcher.
RUN_ENV=test

# ─── MongoDB Atlas (required) ─────────────────────────────────────────────
# test    -> database name: test
# staging -> database name: uaetrail_staging
# prod    -> separate production connection string
# Automated vitest runs MUST use an isolated DB — never your dev/prod database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/uaetrail_test
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/test?retryWrites=true&w=majority&appName=UAETrail
MONGODB_URI_STAGING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_staging?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_prod?retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# ─── JWT Secrets ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=          # REQUIRED
JWT_REFRESH_SECRET=         # REQUIRED

# ─── S3 / MinIO ──────────────────────────────────────────────────────────
S3_ACCESS_KEY_ID=           # REQUIRED — MinIO root user
S3_SECRET_ACCESS_KEY=       # REQUIRED — MinIO root password (min 8 chars)
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
S3_PUBLIC_BUCKET=uaetrail-public
S3_PRIVATE_BUCKET=uaetrail-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost
APP_BASE_URLS=http://localhost,http://localhost:5175

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_SITE_ORIGIN=https://uaetrail.com
# Google OAuth — same Web client ID in both vars below
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443

# ─── Email (verification / password-reset links) ─────────────────────────
# Test + staging OTP emails send from uaetrail@gmail.com via Gmail SMTP.
# 1) Enable 2FA on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
SMTP_GMAIL_USER=uaetrail@gmail.com
SMTP_GMAIL_APP_PASSWORD=          # REQUIRED for real OTP emails in test/staging
EMAIL_FROM=UAE Trail <uaetrail@gmail.com>

# Optional per-environment overrides (same Gmail account for test + staging):
# SMTP_URL_TEST=smtp://uaetrail@gmail.com:APP_PASSWORD@smtp.gmail.com:587
# SMTP_URL_STAGING=smtp://uaetrail@gmail.com:APP_PASSWORD@smtp.gmail.com:587
# EMAIL_FROM_TEST=UAE Trail <uaetrail@gmail.com>
# EMAIL_FROM_STAGING=UAE Trail <uaetrail@gmail.com>

# Production (use your transactional provider — not Gmail):
# SMTP_URL_PROD=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM_PROD=UAE Trail <noreply@uaetrail.com>
# SENDGRID_API_KEY=

# ─── Production checklist (see docs/DEPLOYMENT.md) ───────────────────────
# APP_BASE_URL=https://uaetrail.com
# APP_BASE_URLS=https://uaetrail.com,https://www.uaetrail.com
# VAPID_PUBLIC_KEY=  (npx web-push generate-vapid-keys)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@uaetrail.com

# ─── Observability (docker compose stack) ─────────────────────────────────
# GRAFANA_ADMIN_PASSWORD=          # REQUIRED for production Grafana login
# METRICS_TOKEN=                   # Bearer token for /metrics in production

# ─── Demo seed (development/test only) ────────────────────────────────────
# SEED_DATA=true                   # Seed or reseed demo data (never runs in production)
# FORCE_SEED=1                     # Alias for SEED_DATA=true
# RUN_PROJECT_FORCE_SEED=1         # Alias for SEED_DATA=true
