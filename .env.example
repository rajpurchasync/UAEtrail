# ─── UAE Trail — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
#
# Vite dev: do not set NODE_ENV=test in `.env` (breaks pre-bundling). Use RUN_ENV
# for API/test DB; `.env.development` forces NODE_ENV=development for `npm run dev`.
# ───────────────────────────────────────────────────────────────────────────

# ─── Runtime Environment ───────────────────────────────────────────────────
# Allowed values: test, staging, production
# local is accepted and mapped to test by the launcher.
RUN_ENV=test

# ─── MongoDB ──────────────────────────────────────────────────────────────
# Local dev (Docker): npm run db:local:up → db:local:migrate → db:seed:dev → dev:local
# `dev:local` forces MONGODB_URI to LOCAL_MONGODB_URI (not Atlas).
# test    -> database name: test
# staging -> database name: uaetrail_staging
# prod    -> separate production connection string
# Automated vitest runs MUST use an isolated DB — never your dev/prod database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/uaetrail_test
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/uaetrail_dev
MONGO_PORT=27017
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/test?retryWrites=true&w=majority&appName=UAETrail
MONGODB_URI_STAGING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_staging?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_prod?retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# ─── JWT Secrets ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=          # REQUIRED
JWT_REFRESH_SECRET=         # REQUIRED

# ─── S3 / MinIO ──────────────────────────────────────────────────────────
S3_ACCESS_KEY_ID=           # REQUIRED — MinIO root user
S3_SECRET_ACCESS_KEY=       # REQUIRED — MinIO root password (min 8 chars)
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
S3_PUBLIC_BUCKET=uaetrail-public
S3_PRIVATE_BUCKET=uaetrail-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Optional dev/staging flags (see docs/SYSTEM_COHERENCE.md §8.9 + operations/EXPLORE_MAP_RUNBOOK.md):
# EXPLORE_MAP_BBOX=1
# SIDE_EFFECT_OUTBOX=1   # local/staging parity with prod (prod enables outbox automatically when NODE_ENV=production)
# Seeking storage (after `npm run seeking:storage-status` shows ready): skip new participant_intents stub rows
# PARTICIPANT_INTENT_STUB_WRITE — removed (MIG-DISCO-REG); use member_availability + ops backfill
APP_BASE_URL=http://localhost
APP_BASE_URLS=http://localhost,http://localhost:5175

# ─── Frontend ─────────────────────────────────────────────────────────────
# Optional: force the URL encoded in the dev mobile QR (same Wi‑Fi as phone).
# DEV_MOBILE_URL=http://192.168.1.42:5175/
VITE_API_BASE_URL=/api
# Explore map — outdoor-first basemap (Ridge-style streets + terrain). Free dev fallback: Esri topo.
# VITE_MAPTILER_API_KEY=              # preferred — Streets (map) + Hybrid (satellite); optional VITE_MAPTILER_MAP_STYLE=streets-v2|basic-v2|outdoor-v2
# VITE_MAPBOX_ACCESS_TOKEN=           # alternative — outdoors-v12 / satellite-streets-v12
# VITE_MAP_BASEMAP_PROVIDER=maptiler    # maptiler | mapbox | esri (default: maptiler if key set, else esri)
# VITE_MAP_TILE_URL=                  # full override — {z}/{x}/{y} Leaflet template
# VITE_MAP_LABEL_TILE_URL=            # optional second layer when using VITE_MAP_TILE_URL
# VITE_EXPLORE_MAP_BBOX=1
# VITE_COMMUNITY_DISCOVER=0          # Opt out — Community tab + /clubs/:slug (default: on)
VITE_SITE_ORIGIN=https://uaetrail.com
# Google OAuth — same Web client ID in both vars below
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Windows: run-project also maps http://localhost (port 80). Set FRONTEND_LOCALHOST_ALIAS=0 to disable.
# FRONTEND_LOCALHOST_ALIAS=0
# Production on a host: FRONTEND_BIND=0.0.0.0 and FRONTEND_PORT=80

# ─── Email (verification / password-reset links) ─────────────────────────
# Test + staging OTP emails send from uaetrail@gmail.com via Gmail SMTP.
# 1) Enable 2FA on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
SMTP_GMAIL_USER=uaetrail@gmail.com
SMTP_GMAIL_APP_PASSWORD=          # REQUIRED for real OTP emails in test/staging
EMAIL_FROM=UAE Trail <uaetrail@gmail.com>

# Optional per-environment overrides (same Gmail account for test + staging):
# SMTP_URL_TEST=smtp://uaetrail@gmail.com:APP_PASSWORD@smtp.gmail.com:587
# SMTP_URL_STAGING=smtp://uaetrail@gmail.com:APP_PASSWORD@smtp.gmail.com:587
# EMAIL_FROM_TEST=UAE Trail <uaetrail@gmail.com>
# EMAIL_FROM_STAGING=UAE Trail <uaetrail@gmail.com>

# Production (use your transactional provider — not Gmail):
# SMTP_URL_PROD=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM_PROD=UAE Trail <noreply@uaetrail.com>
# SENDGRID_API_KEY=

# ─── Platform ops (production) ─────────────────────────────────────────────
# Comma-separated emails that may grant/revoke PLATFORM_ADMIN (master admin).
# Demo seed sets profile.platformMasterAdmin on admin@uaetrails.app — use env for prod bootstrap.
# PLATFORM_MASTER_ADMIN_EMAILS=founder@yourcompany.com

# ─── Production checklist (see docs/DEPLOYMENT.md) ───────────────────────
# APP_BASE_URL=https://uaetrail.com
# APP_BASE_URLS=https://uaetrail.com,https://www.uaetrail.com
# VAPID_PUBLIC_KEY=  (npx web-push generate-vapid-keys)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@uaetrail.com

# ─── Observability (docker compose stack) ─────────────────────────────────
# GRAFANA_ADMIN_PASSWORD=          # REQUIRED for production Grafana login
# METRICS_TOKEN=                   # Bearer token for /metrics in production

# ALLOW_DEMO_LOGIN=true            # Required for demo-login on staging (never in production)
# PLATFORM_ADMIN_MFA_SECRET=       # Base32 TOTP secret — required for platform-admin login when set (S10g)
# CHAT_SSE_MAX_CONNECTIONS_PER_USER=4
# EXPLORE_MAP_BBOX=1               # Staging promote after s10e:staging-checklist (API)
# VITE_EXPLORE_MAP_BBOX=1          # Staging FE build — pair with EXPLORE_MAP_BBOX
# DEMO_ACCOUNT_PASSWORD=change-me  # Required for local SEED_DATA + demo-login (not stored in repo)
# SEED_DATA=true                   # Seed or reseed demo data (never runs in production)
# SEED_DEV_RICH=1                  # Extra catalog + 15 outings/month × 3 (db:seed:dev sets this)
# FORCE_SEED=1                     # Alias for SEED_DATA=true
# RUN_PROJECT_FORCE_SEED=1         # Alias for SEED_DATA=true
