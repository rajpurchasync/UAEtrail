# ─── UAE Trail — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # REQUIRED — use a strong random password
POSTGRES_DB=uaetrail
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# ─── JWT Secrets ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=          # REQUIRED
JWT_REFRESH_SECRET=         # REQUIRED

# ─── S3 / MinIO ──────────────────────────────────────────────────────────
S3_ACCESS_KEY_ID=           # REQUIRED — MinIO root user
S3_SECRET_ACCESS_KEY=       # REQUIRED — MinIO root password (min 8 chars)
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost
APP_BASE_URLS=http://localhost,http://localhost:5175

# ─── Frontend ─────────────────────────────────────────────────────────────
# For local dev (laptop + phone on same Wi‑Fi): use /api/v1 (Vite proxies to port 4000)
# For direct API URL without proxy: http://localhost:4000/api/v1
VITE_API_BASE_URL=/api/v1
# Canonical site origin for SEO meta, Open Graph, and JSON-LD (no trailing slash)
# VITE_SITE_ORIGIN=https://uaetrail.ae
# ─── Google OAuth (Sign in with Google) ───────────────────────────────────
# Create a Web client in Google Cloud Console → Credentials.
# Authorized JavaScript origins: http://localhost:5175 (and your production URL)
# Add the SAME client ID to both files below, then restart dev servers.
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
