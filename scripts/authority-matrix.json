{
  "version": 1,
  "dmcpPhase": 8,
  "dmcpStatus": "complete",
  "description": "DMCP eng complete (phases 0–8) — product actions → capability axis → sole resolver. Normative for gates; not user-facing copy.",
  "program": "refactor-program.json · P4b/P5",
  "minActions": 40,
  "axes": {
    "A_RBAC": "Platform/job role — auth middleware, route mounts, admin/merchant API",
    "B_PUBLISH": "Host publish capabilities — GET /me/status publish.* only",
    "C_STOREFRONT": "Tenant storefront kind — PublishingProfileKind, x-organisation-id",
    "D_PARTICIPATE": "Per-outing engagement — viewerAccess, join spine, medical safety",
    "E_ENGAGEMENT": "Points/membership tier — badges, reviews; never publish/join"
  },
  "readCompatChokePoints": [
    {
      "id": "compose-seek-inbound",
      "module": "packages/shared-types/src/compose-route.ts",
      "rule": "migrateLegacyComposeWire / parseComposeWire migrates seek:* · host:* · availability:* · add:* → activity · intent · place inbound only",
      "forbidEmitIn": ["src/explore", "src/list", "apps/api/src/routes"]
    },
    {
      "id": "map-source-inbound",
      "module": "packages/shared-types/src/wire-lexicon.ts",
      "rule": "normalizeExploreMapSource / isPlaceMapSource for venue|catalog_place aliases"
    },
    {
      "id": "people-crews-tab-inbound",
      "module": "src/routing/productUrlInbound.ts",
      "rule": "readPeopleCrewsTabParam inbound; stripRetiredPeopleListTabParams on outbound (peopleTab canonical)",
      "forbidEmitIn": ["src/list", "src/explore", "src/people-discovery"]
    }
  ],
  "forbiddenPatterns": [
    {
      "id": "seek-compose-emit",
      "pattern": "`seek:fixed:`|`seek:flexible`",
      "allowedModules": ["packages/shared-types/src/compose-route.ts", "packages/shared-types/src/compose-route.test.ts"]
    },
    {
      "id": "explore-hub-module",
      "pathMustNotExist": "src/explore/hub"
    },
    {
      "id": "consumer-become-host",
      "pattern": "path: '/become-host'",
      "scanRoots": ["src"],
      "allowedModules": ["src/config/memberRoutes.ts", "src/config/platform.ts", "src/App.tsx"]
    }
  ],
