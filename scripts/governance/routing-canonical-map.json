{
  "version": 1,
  "enforcement": "phase4",
  "description": "Canonical HTTP + SPA routing planes. Operator desk SPA /operator/*; supply HTTP /workspace/*.",
  "pcohTarget": {
    "operator_workspace_api": "/workspace",
    "operator_workspace_spa_prefix": "/operator"
  },
  "planes": {
    "operator_workspace": {
      "spa": ["/operator/overview", "/operator/activities", "/operator/requests", "/operator/team", "/operator/profile", "/operator/places", "/operator/history"],
      "api": ["/workspace"],
      "feDomain": "operatorWorkspace.ts"
    },
    "member_identity": {
      "spa": ["/member/:userId"],
      "api": ["/member/:userId/brief", "/member/:userId/profile", "/member/:userId/upcoming-activities", "/me/profile"],
      "feDomain": "account.ts"
    },
    "member_discovery": {
      "spa": ["/explore", "/list"],
      "api": [
        "/discover/crew",
        "/me/member-discovery/quota",
        "/me/member-discovery/browse",
        "/me/member-discovery/network",
        "/me/member-discovery/network/preview",
        "/me/member-discovery/search"
      ],
      "feDomain": "account.ts"
    },
    "participation": {
      "spa": ["/activity/:id", "/my-requests"],
      "api": ["/activities", "/me/requests", "/me/activities"],
      "feDomain": "activities.ts"
    },
    "trust_safety": {
      "spa": [],
      "api": ["/safety/reports"],
      "feDomain": "safety.ts"
    },
    "discovery": {
      "spa": ["/explore", "/list"],
      "api": ["/explore/map", "/explore/people/availability", "/me/discover/overlay"],
      "feDomain": "explore.ts"
    },
    "social_graph": {
      "spa": ["/crews", "/groups"],
      "api": ["/me/friends", "/me/friend-requests", "/me/groups", "/me/following"],
      "feDomain": "friends.ts"
    },
    "engagement": {
      "spa": [],
      "api": ["/me/wishlist", "/me/entity-follows", "/reviews", "/me/reviews"],
      "feDomain": "wishlist.ts"
    }
  },
  "forbidden": {
    "apiPathPrefixes": ["/host/", "/social/", "/users/"],
    "spaPathPrefixes": ["/host/", "/organizer/"],
    "middlewareModules": [
      "legacy-host-api-rewrite.ts",
      "legacy-publishing-path-deprecation.ts",
      "legacy-member-status-path-rewrite.ts"
    ]
  }
}
