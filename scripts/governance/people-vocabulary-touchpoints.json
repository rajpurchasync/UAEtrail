{
  "$schema": "./people-vocabulary-touchpoints.schema.json",
  "version": 2,
  "programId": "MIG-PEOPLE-VOCAB-2026",
  "summary": "Three surfaces: Intent compose (write member_availability) · Find crew (discover read) · My crew (social hub). Six pillars in crew-pillars.ts. No hireable/memberHireable in source. Guide = intent kind; guides_operators = directory pros.",
  "surfaces": {
    "intent_compose": {
      "writes": ["PUT /me/availability"],
      "feRoots": [
        "src/explore/ui/IntentOpenComposeSheet.tsx",
        "src/components/plan/PlanAvailabilitySection.tsx",
        "src/explore/ui/intentFixedFlowEngine.ts"
      ]
    },
    "find_crew": {
      "reads": [
        "GET /discover/crew",
        "GET /me/member-discovery/browse",
        "GET /explore/map?sources=availability"
      ],
      "feRoots": [
        "src/crew-discovery/panel/CrewsBrowsePanel.tsx",
        "src/crew-discovery/crewBrowseTab.ts",
        "src/crew-discovery/memberBrowseRowModel.ts",
        "src/list/explorer/ListCrewsExplorer.tsx"
      ],
      "browseTabs": ["people", "professional", "community"],
      "peopleFacets": ["recommended", "friends", "available", "everyone"]
    },
    "my_crew": {
      "routes": ["/crews", "/groups"],
      "mustNot": ["GET /me/member-discovery/browse as primary hub body"],
      "feRoots": ["src/pages/MyCrews.tsx", "src/components/social/SocialHubIndex.tsx", "src/pages/Groups.tsx"]
    }
  },
  "crewPillars": [
    "friends",
    "directory",
    "teams",
    "communities",
    "guides_operators",
    "outing_roster",
    "intent_signal"
  ],
  "phases": [
    {
      "id": "P0-lexicon",
      "status": "complete",
      "deliverables": ["packages/shared-types/src/crew-pillars.ts", "crewPillarsAlignmentGuard", "upl-glossary UPL_INTENT_*"]
    },
    {
      "id": "P1-friends",
      "status": "complete",
      "deliverables": ["/crews + notifications + invite modals horizontal pass"]
    },
    {
      "id": "P2-teams-communities",
      "status": "complete",
      "deliverables": [
        "Groups Teams copy",
        "MIG-COMMUNITY-DISCOVER complete (discoverable clubs API + Crews Community tab)",
        "member-group-model-guard"
      ]
    },
    {
      "id": "P3-guides-directory",
      "status": "complete",
      "deliverables": [
        "crewsGuides rail",
        "People everyone → connect data lane",
        "guide kind vs profileRoleLabel",
        "proKind chips on Professional lane"
      ]
    },
    {
      "id": "P4-outing-roster",
      "status": "complete",
      "deliverables": ["tab=crew", "ActivityDetailCrewAside"]
    },
    {
      "id": "P5-intent-spine",
      "status": "complete",
      "deliverables": ["intentFixedFlowEngine", "UPL_INTENT Plan/Crews", "wizard intentFixedFlow"]
    },
    {
      "id": "P5c-find-crew-lenses",
      "status": "complete",
      "deliverables": ["Guide chip in open intent", "Available tab guide filter", "my crew hub boundary guard"]
    },
    {
      "id": "P5d-crews-three-tabs",
      "status": "complete",
      "deliverables": [
        "peopleTab people|professional|community",
        "peopleFacet recommended + pills",
        "Remove hub + CrewsHubHome",
        "Crews pill list-search parity",
        "Professional tab agencies+guides",
        "Community tab feature gate"
      ]
    },
    {
      "id": "P6-wishlist",
      "status": "complete",
      "deliverables": ["saveWishlistTarget facade", "PVOC-07", "wishlistWriteFacadeGuard"]
    },
    {
      "id": "P8-docs",
      "status": "complete",
      "deliverables": ["MEMBER_MODEL", "NAVIGATION", "plan §1.5 surfaces", "P5d browse tables aligned"]
    },
    {
      "id": "P7-wire-cleanup",
      "status": "complete",
      "deliverables": [
        "Canonical friends wire GET /me/friends",
        "fetchMeFriends in invite client",
        "Removed GET /me/friends"
      ]
    }
  ],
  "terms": {
    "crew_ui": "Umbrella: My crew, Crews tab, Find your crew, activity Crew tab (outing roster).",
    "friends_ui": "Mutual connections on /crews — not Everyone directory.",
    "teams_ui": "Private teams /groups — member_group.kind=team; not communities; not outing_crew.",
    "intent_guide_kind": "member_availability.kinds includes guide — product label Guide on Available rows.",
    "guides_operators_ui": "Professional tab — profileRoleLabel; crewsGuides rail.",
    "directory_ui": "People tab Everyone — connect lane; not friends mutual graph; not Professional.",
    "friends_wire": "HTTP /me/friends, segment=friends — UI Friends.",
    "intent_compose": "?compose=intent:open|intent:fixed:* → PUT /me/availability.",
    "wishlist_engagement": "POST /me/wishlist on /plan — never compose wire."
  },
  "touchpoints": [
    {
      "id": "surface.my_crews",
      "matrixRows": ["C-01", "C-13"],
      "contextIds": ["social_graph"],
      "route": "/crews",
      "feRoots": ["src/pages/MyCrews.tsx", "src/components/social/SocialHubIndex.tsx"],
      "uiLabels": ["PRODUCT_MY_CREW_SURFACE_TITLE", "PRODUCT_FRIENDS_SURFACE_LABEL"],
      "wire": ["/me/friends", "/me/friend-requests", "/me/following"],
      "mustNot": ["Primary render of member-discovery browse/directory roster"]
    },
    {
      "id": "surface.find_crew",
      "matrixRows": ["C-06", "C-11", "C-12"],
      "contextIds": ["member_discovery", "discovery", "compose"],
      "route": "/list?listCat=people",
      "feRoots": [
        "src/crew-discovery/panel/CrewsBrowsePanel.tsx",
        "src/crew-discovery/panel/crewBrowse/CrewBrowseTabContent.tsx",
        "src/crew-discovery/crewBrowseTab.ts"
      ],
      "uiLabels": ["EXPLORE_CREWS_PANEL_TITLE", "PEOPLE_BROWSE_TAB_LABELS"],
      "wire": ["GET /discover/crew", "sources=availability", "segment=connect"]
    },
    {
      "id": "surface.teams",
      "matrixRows": ["C-02"],
      "contextIds": ["social_graph", "communication"],
      "route": "/groups",
      "feRoots": ["src/pages/Groups.tsx"],
      "uiLabels": ["PRODUCT_GROUPS_SURFACE_LABEL"],
      "wire": ["social_groups", "member_group.kind=team"]
    },
    {
      "id": "surface.messages",
      "matrixRows": ["C-08"],
      "contextIds": ["communication", "social_graph"],
      "route": "/chat",
      "feRoots": ["src/pages/Messages.tsx", "src/messaging", "src/utils/notificationRouting.ts"],
      "uiLabels": ["Chat"],
      "wire": ["/chat", "chat_messages", "chat-policy eligibility via friends graph"]
    },
    {
      "id": "surface.guides_directory",
      "matrixRows": ["C-04"],
      "contextIds": ["member_discovery", "member_identity"],
      "route": "/list?listCat=people&peopleTab=professional",
      "feRoots": ["src/list/crews/crewsGuides.ts", "src/crew-discovery/memberBrowseRowModel.ts"],
      "uiLabels": ["UPL_CREW_PILLAR_GUIDES"],
      "wire": ["/me/member-discovery/browse", "profileRoleLabel"]
    },
    {
      "id": "participation.activity_crew_tab",
      "matrixRows": ["C-05"],
      "contextIds": ["participation", "communication"],
      "route": "/activity/:id?tab=crew",
      "feRoots": [
        "src/components/activity/detail/tabs/ActivityDetailCrewAside.tsx",
        "src/pages/ActivityCrewPage.tsx"
      ],
      "uiLabels": ["ACTIVITY_DETAIL_TAB_CREW"],
      "wire": ["viewerAccess.canAccessCrewSurfaces", "activity group chat"]
    },
    {
      "id": "participation.join_invite",
      "matrixRows": ["C-10"],
      "contextIds": ["participation", "social_graph"],
      "feRoots": [
        "src/components/activity/ActivityInviteModalBody.tsx",
        "src/components/activity/ActivityInviteLauncher.tsx",
        "src/hooks/activityInviteClientApi.ts"
      ],
      "uiLabels": ["Friends", "Invite friends"],
      "wire": ["/activities/:id/invites", "GET /me/friends"]
    },
    {
      "id": "member.public_profile",
      "matrixRows": ["C-01"],
      "contextIds": ["social_graph", "member_identity"],
      "feRoots": [
        "src/pages/MemberProfile.tsx",
        "src/components/profile/MemberProfileFriendActions.tsx"
      ],
      "uiLabels": ["Add friend", "Friends"],
      "wire": ["/me/friend-requests", "member-profile-social-graph"]
    },
    {
      "id": "compose.intent",
      "matrixRows": ["C-06", "C-11", "C-12"],
      "contextIds": ["compose", "engagement"],
      "feRoots": [
        "src/explore/compose.ts",
        "src/explore/ui/intentFixedFlowEngine.ts",
        "packages/shared-types/src/member-availability.ts",
        "packages/shared-types/src/compose-route.ts"
      ],
      "uiLabels": ["UPL_INTENT_OPEN_ACTION", "guide kind in AVAILABILITY_KINDS"],
      "wire": ["PUT /me/availability", "kinds: hiking|guide|…"]
    },
    {
      "id": "engagement.wishlist",
      "matrixRows": ["C-07"],
      "contextIds": ["engagement"],
      "feRoots": ["src/wishlist/saveWishlistTarget.ts", "src/plan/planTab.ts"],
      "uiLabels": ["Wishlist"],
      "wire": ["/me/wishlist"],
      "mustNot": ["compose=wishlist"]
    },
    {
      "id": "notifications.deep_links",
      "matrixRows": ["C-09"],
      "contextIds": ["communication", "social_graph", "participation"],
      "feRoots": ["src/utils/notificationRouting.ts", "src/utils/notificationTopics.ts"],
      "wire": ["notification-meta connection_friend_request → /crews"]
    }
  ]
}