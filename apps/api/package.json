{
  "name": "@uaetrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-dist-data.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx scripts/seed.ts",
    "mongo:sync": "tsx scripts/mongo-sync.ts",
    "seed:catalog-facilities": "tsx scripts/run-seed-catalog-facilities.ts",
    "bump-activity-dates": "tsx scripts/bump-activity-dates.ts",
    "refresh-seeking-schedules": "tsx scripts/refresh-seeking-schedules.ts",
    "backfill-seeking-activities": "tsx scripts/backfill-seeking-activities.ts",
    "backfill-rideshare-vehicles": "tsx scripts/backfill-rideshare-vehicles.ts",
    "backfill-location-area-ids": "tsx scripts/backfill-location-area-ids.ts",
    "backfill-geo-hierarchy": "tsx scripts/backfill-geo-hierarchy.ts",
    "cleanup:orphan-locations": "tsx scripts/run-cleanup-orphan-locations.ts",
    "ensure-demo-explore-activities": "tsx scripts/run-ensure-demo-explore-activities.ts",
    "seed-dev-qa": "tsx scripts/run-dev-qa-bundle.ts",
    "seeking-storage-status": "tsx scripts/seeking-storage-status.ts",
    "cancel-coordless-participant-intents": "tsx scripts/cancel-coordless-participant-intents.ts",
    "import-venue-catalog": "tsx scripts/import-venue-catalog.ts",
    "backfill-catalog-locations": "tsx scripts/import-venue-catalog.ts -- --keep-osm",
    "cleanup:test-users": "node scripts/cleanup-test-users.mjs",
    "purge-demand-wishlist-rows": "tsx scripts/purge-demand-wishlist-rows.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@otplib/preset-default": "^12.0.1",
    "@uaetrail/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.4"
  }
}
