NODE_ENV=development
PORT=4000
# Required — MongoDB Atlas URIs
# test database    = test
# staging database = uaetrail_staging
# production       = separate production URI
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/test?retryWrites=true&w=majority
MONGODB_URI_STAGING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_staging?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_prod?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
APP_BASE_URL=http://localhost:5175
APP_BASE_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
API_BASE_URL=http://localhost:4000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Browser-facing URL for uploaded assets (use public MinIO/S3 URL in production)
# S3_PUBLIC_URL=http://localhost:9000

# Email (required for production signup / password reset)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SENDGRID_API_KEY=
# EMAIL_FROM=UAE Trail <noreply@uaetrail.ae>
# Or: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE=false

# Optional — Stripe native checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@uaetrail.ae

# Optional — Redis (rate limiting across instances; defaults to in-memory if unset)
# REDIS_URL=redis://localhost:6379

# Optional — Google OAuth (Web client ID from Google Cloud Console)
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=generate-a-strong-password
