# Production environment template — copy to server .env and fill in real values.
# Validate before deploy: node scripts/validate-env.mjs --production --file .env

NODE_ENV=production
RUN_ENV=production
PORT=4000

# MongoDB Atlas
# test database    = test
# staging database = uaetrail_staging
# production       = separate production URI
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/test?retryWrites=true&w=majority
MONGODB_URI_STAGING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_staging?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail_prod?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Public HTTPS URLs for your domain
# The frontend proxies /api to the internal api container, so use the public site origin here.
APP_BASE_URL=https://uaetrail.com
APP_BASE_URLS=https://uaetrail.com,https://www.uaetrail.com
API_BASE_URL=https://uaetrail.com
VITE_SITE_ORIGIN=https://uaetrail.com

# Redis (required in production)
REDIS_URL=redis://redis:6379

# S3-compatible storage (MinIO on VPS or cloud object storage)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://assets.example.com
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
S3_PUBLIC_BUCKET=uaetrail-public
S3_PRIVATE_BUCKET=uaetrail-private
S3_ACCESS_KEY_ID=replace-minio-access-key
S3_SECRET_ACCESS_KEY=replace-minio-secret-key
S3_FORCE_PATH_STYLE=true

# Email (required for production — use transactional provider, not Gmail)
SMTP_URL_PROD=smtp://user:pass@smtp.example.com:587
EMAIL_FROM_PROD=UAE Trail <noreply@uaetrail.com>
# SENDGRID_API_KEY=

# Stripe (if shop/premium payments enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@uaetrail.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
