# Production environment template — copy to server .env and fill in real values.
# Validate before deploy: node scripts/validate-env.mjs --production --file .env

NODE_ENV=production
PORT=4000

# MongoDB Atlas (or managed MongoDB)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uaetrail?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public HTTPS URLs for your domain
APP_BASE_URL=https://app.example.com
APP_BASE_URLS=https://app.example.com,https://www.example.com
API_BASE_URL=https://api.example.com

# Redis (required in production)
REDIS_URL=redis://redis:6379

# S3-compatible storage (MinIO on VPS or cloud object storage)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://assets.example.com
S3_REGION=us-east-1
S3_BUCKET=uaetrail-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Email (required)
SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=UAE Trail <noreply@example.com>

# Stripe (if shop/premium payments enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
